{
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Key": "${Jwt__Key}",
    "Issuer": "${Jwt__Issuer}",
    "Audience": "${Jwt__Audience}",
    "DurationInMinutes": "${Jwt__DurationInMinutes}"
  },

  "OtpSms": {
    "Enabled": "${OtpSms__Enabled}",
    "GatewayUrl": "${OtpSms__GatewayUrl}",
    "Username": "${OtpSms__Username}",
    "Password": "${OtpSms__Password}",
    "SenderId": "${OtpSms__SenderId}",
    "SecureKey": "${OtpSms__SecureKey}",
    "ServiceType": "${OtpSms__ServiceType}",
    "PortalName": "${OtpSms__PortalName}",
    "MessageTemplate": "${OtpSms__MessageTemplate}",
    "Templates": {
      "SupplierAuth": "${OtpSms__Templates__SupplierAuth}",
      "IndentFinalize": "${OtpSms__Templates__IndentFinalize}"
    }
  },

  "AllowedHosts": "*"
}
