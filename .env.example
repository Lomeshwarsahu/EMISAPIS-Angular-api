# EMIS API — environment template
# Copy to `.env` and fill real values:
#   cp .env.example .env
#
# `.env` is gitignored. Nested ASP.NET keys use `__`.

# --- SQL ---
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=EMIS;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False

# --- JWT ---
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Jwt__Issuer=MyApi
Jwt__Audience=MyApiUsers
Jwt__DurationInMinutes=60

# --- OTP SMS (mGov DLT) ---
OtpSms__Enabled=true
OtpSms__GatewayUrl=https://msdgweb.mgov.gov.in/esms/sendsmsrequestDLT
OtpSms__Username=YOUR_SMS_USERNAME
OtpSms__Password=YOUR_SMS_PASSWORD
OtpSms__SenderId=CGMSCL
OtpSms__SecureKey=YOUR_SMS_SECURE_KEY
OtpSms__ServiceType=otpmsg
OtpSms__PortalName=EMIS
OtpSms__MessageTemplate=OTP for submission in {portal} is {otp}. Please do not share with anyone.
OtpSms__Templates__SupplierAuth=1407162263151118865
OtpSms__Templates__IndentFinalize=1407163911599431374

# --- Optional file roots ---
# FileStorage__IndentUploadsPath=
# FileStorage__ComplaintPath=
# FileStorage__EmdDepositPath=
# FileStorage__SdDetailPath=
# FileStorage__PoExtensionPath=
# FileStorage__SpecificationPath=
